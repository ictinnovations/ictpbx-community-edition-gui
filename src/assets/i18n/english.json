        "transmission": {
            "title": "Send a Single Transmission",
            "description": "ICTCore allows to support different kind of transmissions like Voice Call, SMS, Email and Fax to send message to a single contact.",
            "voice": {
                "title": "Voice call",
                "description": "This transmission dials number from a contact list and on answer plays a recorded message."
            },
            "sms": {
                "title": "SMS Transmission",
                "description": "This transmission selects number from a contact list and simply broadcast a text message to the contact group."
            },
            "email": {
                "title": "Email Transmission",
                "description": "This transmission sends email to the specified email address of your contact."
            },
            "fax": {
                "title": "Fax Transmission",
                "description": "This transmission dials number from a contact list and on answer transfer fax documents. "
            },
            "ivr": {
                "title": "IVR Transmission",
                "description": "This transmission dials number from a contact list and on answer plays the IVR menu. "
            }
        },
        "campaigns": {
            "title": "Launch a Campaign",
            "description": "ICTCore supports complete campaign management. Each user can manage, monitor, and run multiple campaigns separately and independently to send message to contact group.",
            "voice": {
                "title": "Voice Campaign",
                "description": "This campaign dials number from a contact list and on answer plays a recorded message."
            },
            "sms": {
                "title": "SMS Campaign",
                "description": "This campaign selects number from a contact list and simply broadcast a text message to the contact. "
            },
            "email": {
                "title": "Email Campaign",
                "description": "This campaign sends email to the specified email address of your contact group."
            },
            "fax": {
                "title": "Fax Campaign",
                "description": "This campaign dials number from a contact list and on answer transfer fax documents."
            },
            "ivr": {
                "title": "IVR Campaign",
                "description": "This campaign dials number from a contact list and on answer play the IVR menu."
            }
        }
    },
